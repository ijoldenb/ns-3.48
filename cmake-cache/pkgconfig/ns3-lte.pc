Libs: -L"${libdir}" -lns3.48-lte-default  -lns3.48-fd-net-device-default -lns3.48-spectrum-default -lns3.48-buildings-default -lns3.48-virtual-net-device-default -lns3.48-point-to-point-default -lns3.48-applications-default -lns3.48-csma-default -lns3.48-config-store-default -lstdc++_libbacktrace
Libs.private: -L"${libdir}" 
